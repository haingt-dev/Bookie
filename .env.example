# Copy thành .env (gitignored) rồi điền key thật.
# Dùng bởi: gen-art / imagegen CLI (sinh nền minh hoạ cho design system).
OPENAI_API_KEY=sk-...

# Form đăng ký tự động (shared/event-automation — xem README mục Deploy).
# URL Web App sau khi deploy Apps Script; SECRET khớp Script Properties.
BOOKIE_FORM_WEBAPP_URL=https://script.google.com/macros/s/.../exec
BOOKIE_FORM_SECRET=...
